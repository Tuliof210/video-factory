{
  "name": "video-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "video": "tsx src/cli.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "hyperframes": "hyperframes",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "schemas": "tsx scripts/schemas.ts",
    "format": "prettier --write src scripts tests README.md package.json tsconfig.json",
    "format:check": "prettier --check src scripts tests README.md package.json tsconfig.json"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "commander": "^14.0.0",
    "dotenv": "^17.2.0",
    "music-metadata": "^11.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.539",
    "three": "0.187.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "hyperframes": {
      "undici": "7.30.1"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.187.0",
    "hyperframes": "0.9.8",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
