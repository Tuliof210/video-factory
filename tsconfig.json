{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@channel": [
        "./channel/remotion/index.tsx",
        "./src/remotion/no-channel.tsx"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "remotion.config.ts",
    "channel/remotion"
  ]
}
